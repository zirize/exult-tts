diff --git a/tts.cc b/tts.cc
new file mode 100644
index 0000000..6c4e1ea
--- /dev/null
+++ b/tts.cc
@@ -0,0 +1,205 @@
+/*
+ *  tts.cc - Read game text aloud through an external speech command.
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License as published by
+ *  the Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+
+#ifdef HAVE_CONFIG_H
+#	include <config.h>
+#endif
+
+#include "tts.h"
+
+#include "Configuration.h"
+#include "utils.h"
+
+#include <cctype>
+#include <iostream>
+#include <string>
+
+#if defined(__unix__) || defined(__APPLE__)
+#	define TTS_POSIX 1
+#	include <signal.h>
+#	include <spawn.h>
+#	include <sys/wait.h>
+#	include <unistd.h>
+extern char** environ;
+#endif
+
+namespace {
+	bool        tts_enabled   = false;    // User's choice.
+	bool        tts_available = false;    // Command found and runnable here.
+	bool        tts_signs     = true;     // Also read rune signs.
+	std::string tts_command;
+	std::string last_text;    // Cleaned text last spoken (for only_if_new).
+#ifdef TTS_POSIX
+	pid_t speaker_pid = -1;    // Process group of the running command.
+#endif
+
+	// Turn Exult's text markup into plain sentences for a speech engine.
+	std::string clean_text(const std::string& in) {
+		std::string out;
+		out.reserve(in.size());
+		bool space = true;    // Collapse runs of whitespace; drop leading ones.
+		for (const char ch : in) {
+			const auto c = static_cast<unsigned char>(ch);
+			if (c == '*') {    // Page break: end the sentence.
+				while (!out.empty() && out.back() == ' ') {
+					out.pop_back();
+				}
+				if (!out.empty() && !std::ispunct(static_cast<unsigned char>(out.back()))) {
+					out += '.';
+				}
+				if (!out.empty()) {
+					out += ' ';
+				}
+				space = true;
+				continue;
+			}
+			if (c == '^' || c == '@' || c >= 0x80 || (c < 0x20 && c != '\n' && c != '\t')) {
+				continue;    // Capital marker, quote glyph, font-only bytes.
+			}
+			if (c == '~' || std::isspace(c)) {
+				if (!space) {
+					out += ' ';
+					space = true;
+				}
+				continue;
+			}
+			out += ch;
+			space = false;
+		}
+		while (!out.empty() && out.back() == ' ') {
+			out.pop_back();
+		}
+		return out;
+	}
+
+#ifdef TTS_POSIX
+	void reap_and_kill(bool kill_running) {
+		if (speaker_pid <= 0) {
+			return;
+		}
+		if (kill_running) {
+			kill(-speaker_pid, SIGTERM);    // The whole pipeline in the group.
+			waitpid(speaker_pid, nullptr, 0);
+			speaker_pid = -1;
+		} else if (waitpid(speaker_pid, nullptr, WNOHANG) == speaker_pid) {
+			speaker_pid = -1;
+		}
+	}
+#endif
+}    // namespace
+
+void TTS_init() {
+	std::string value;
+	config->value("config/audio/tts/enabled", value, "yes");
+	tts_enabled = value != "no";
+	config->value("config/audio/tts/signs", value, "yes");
+	tts_signs = value != "no";
+	config->value("config/audio/tts/command", tts_command, "");
+	if (tts_command.empty()) {
+		tts_command = get_system_path("<DATA>/tts_wrapper");
+	}
+#ifdef TTS_POSIX
+	tts_available = access(tts_command.c_str(), X_OK) == 0;
+#endif
+	if (!tts_available) {
+		std::cout << "TTS: " << tts_command << " not executable, voice off" << std::endl;
+	} else {
+		std::cout << "TTS: using " << tts_command << (tts_enabled ? "" : " (voice off in config)") << std::endl;
+	}
+}
+
+bool TTS_is_enabled() {
+	return tts_enabled;
+}
+
+bool TTS_is_available() {
+	return tts_available;
+}
+
+void TTS_set_enabled(bool on) {
+	tts_enabled = on;
+	if (!on) {
+		TTS_stop();
+	}
+}
+
+bool TTS_signs_enabled() {
+	return tts_signs;
+}
+
+void TTS_set_signs(bool on) {
+	tts_signs = on;
+}
+
+std::string TTS_runes_to_text(const std::string& runes) {
+	std::string out;
+	out.reserve(runes.size() + 8);
+	for (const char ch : runes) {
+		switch (ch) {
+		case '(':
+			out += "th";
+			break;
+		case ')':
+			out += "ee";
+			break;
+		case '*':
+			out += "ng";
+			break;
+		case '+':
+			out += "ea";
+			break;
+		case ',':
+			out += "st";
+			break;
+		case '|':
+			out += ' ';
+			break;
+		default:
+			out += static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+		}
+	}
+	return out;
+}
+
+void TTS_say(const std::string& text, const std::string& speaker, bool only_if_new) {
+	const std::string body = clean_text(text);
+	if (body.empty() || (only_if_new && body == last_text)) {
+		return;
+	}
+	last_text                = body;
+	const bool        tag    = !speaker.empty() && speaker.front() == '[';
+	const bool        quiet  = !speaker.empty() && speaker.front() == ':';
+	const std::string who    = clean_text(quiet ? speaker.substr(1) : speaker);
+	const std::string log    = who.empty() ? body : (tag ? who + " " + body : who + ": " + body);
+	const std::string spoken = (who.empty() || tag || quiet) ? body : who + ": " + body;
+	std::cout << "TTS: " << log << std::endl;
+	if (!tts_enabled || !tts_available) {
+		return;
+	}
+#ifdef TTS_POSIX
+	reap_and_kill(true);
+	posix_spawnattr_t attr;
+	posix_spawnattr_init(&attr);
+	posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETPGROUP);
+	posix_spawnattr_setpgroup(&attr, 0);    // New group, led by the child.
+	char* argv[] = {const_cast<char*>(tts_command.c_str()), const_cast<char*>(spoken.c_str()), nullptr};
+	pid_t pid;
+	if (posix_spawn(&pid, tts_command.c_str(), nullptr, &attr, argv, environ) == 0) {
+		speaker_pid = pid;
+	}
+	posix_spawnattr_destroy(&attr);
+#endif
+}
+
+void TTS_stop() {
+	last_text.clear();
+#ifdef TTS_POSIX
+	reap_and_kill(true);
+#endif
+}
diff --git a/tts.h b/tts.h
new file mode 100644
index 0000000..1d1f4f2
--- /dev/null
+++ b/tts.h
@@ -0,0 +1,49 @@
+/*
+ *  tts.h - Read game text aloud through an external speech command.
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License as published by
+ *  the Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+
+#ifndef TTS_H
+#define TTS_H
+
+#include <string>
+
+// Read the configuration and locate the speech command.  Config keys:
+//   config/audio/tts/enabled  "yes" (default) or "no"
+//   config/audio/tts/command  program to run (default "<DATA>/tts_wrapper")
+//   config/audio/tts/signs    "yes" (default) or "no": also read rune signs
+// The command is run as `command "<text>"` in its own process group and is
+// expected to speak the text and exit.  Speech is off if it is not executable.
+void TTS_init();
+
+// The user's on/off choice (Audio options gump), and whether the command exists.
+bool TTS_is_enabled();
+bool TTS_is_available();
+void TTS_set_enabled(bool on);    // Stops speech when turned off; not saved here.
+bool TTS_signs_enabled();         // Read signs, plaques and tombstones too.
+void TTS_set_signs(bool on);      // Not saved here.
+
+// Plain text of one line of rune text as stored in usecode: the ligature
+// characters are expanded ('(' TH, ')' EE, '*' NG, '+' EA, ',' ST, '|' space)
+// and the all-capitals text is lowercased so it is not spelled out.
+std::string TTS_runes_to_text(const std::string& runes);
+
+// Speak one piece of game text, cutting off whatever is still being spoken.
+// Exult text markup ('*' page break, '~' line break, '^' capital, '@' quote)
+// is cleaned up first.  A non-empty speaker is said first ("Iolo: ..."); a
+// leading ':' (":Iolo") keeps the speaker on stdout while omitting it from
+// speech (for subsequent pages), and a bracketed tag ("[Book]", "[Scroll]",
+// "[Sign]") labels stdout without being spoken aloud.
+// With only_if_new, text identical to the last one spoken is skipped (for
+// gumps that repaint the same page many times).  Every line is also written
+// to stdout as "TTS: <line>", voice on or off, as a readable text history.
+void TTS_say(const std::string& text, const std::string& speaker = std::string(), bool only_if_new = false);
+
+// Stop speaking and forget the last text.
+void TTS_stop();
+
+#endif
